# Bookora Environment Configuration
# Copy this file to .env and fill in your actual values.
# DO NOT commit the real .env file to git.

# Email Configuration for OTP System
# Get a Gmail app password from: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# Database Configuration (defaults match a local XAMPP MySQL install)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=bookora

# Application Settings
# Generate a strong value for production, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
# Keep DEBUG=False in production; set True only for local development
DEBUG=False

# Session cookie security.
# The login session is a signed cookie (signed with SECRET_KEY). Set this to
# True in production so the cookie is only sent over HTTPS. Leave False for
# local HTTP development, otherwise the browser will not send the cookie.
SESSION_COOKIE_SECURE=False

# Optional: override the port the Flask dev server listens on (default 5000)
# PORT=5000
